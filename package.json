{
  "name": "agile-ops-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "Agile Ops & Delivery Dashboard for Jira Cloud - Flow Metrics, WIP Limits, Backlog Aging and Quality Analytics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "forge": "forge",
    "forge:login": "forge login",
    "forge:register": "forge register",
    "forge:deploy": "npm run build && forge deploy",
    "forge:deploy:prod": "npm run build && forge deploy -e production",
    "forge:install": "forge install",
    "forge:install:prod": "forge install -e production",
    "forge:lint": "forge lint",
    "forge:tunnel": "forge tunnel"
  },
  "dependencies": {
    "@forge/bridge": "^7.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.5.5",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.43.0",
    "papaparse": "^5.7.0",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@forge/cli": "^14.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
